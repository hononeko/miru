# Server
MIRU_HOST=0.0.0.0
MIRU_PORT=8080
MIRU_CORS_ALLOWED_ORIGINS=http://localhost:5173
# STATIC_WEB_DIR=./web/build

# Database (sqlite | postgres)
DB_ENGINE=sqlite
SQLITE_PATH=./data/miru.db
# DATABASE_URL=jdbc:postgresql://localhost:5432/miru
# DATABASE_USER=miru
# DATABASE_PASSWORD=change-me
# DATABASE_MAX_POOL_SIZE=10

# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=replace-with-plex-token
PLEX_POLL_INTERVAL_SECONDS=20
PLEX_WEBSOCKET_ENABLED=true

# Session tracking
MIN_PLAY_DURATION_SECONDS=120
RESUME_MERGE_WINDOW_SECONDS=120
WATCHED_THRESHOLD_PERCENT=85

# Auth (local | oidc | none)
AUTH_MODE=local
AUTH_SESSION_SECRET=replace-with-at-least-32-character-random-secret
AUTH_ALLOW_LOCAL_LOGIN=true
# MIRU_ADMIN_USERNAME=admin
# MIRU_ADMIN_PASSWORD=replace-with-strong-password

# OIDC / SSO (enabled automatically when AUTH_MODE=oidc, or set OIDC_ENABLED=true for hybrid mode)
OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://auth.example.com/application/o/miru/
# OIDC_CLIENT_ID=miru
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPES=openid,profile,email,groups
OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUPS=miru-admins
# OIDC_USER_GROUPS=miru-users
OIDC_AUTO_LINK_BY_EMAIL=true
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login

# Logging
LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO
