{
  "name": "miru-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "api:gen": "openapi-typescript ../src/main/resources/openapi/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../src/main/resources/openapi/openapi.yaml -o /tmp/miru-schema-check.d.ts && diff -u src/lib/api/schema.d.ts /tmp/miru-schema-check.d.ts && rm -f /tmp/miru-schema-check.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "bits-ui": "^2.15.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.577.0",
    "openapi-fetch": "^0.15.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "happy-dom": "^20.0.11",
    "openapi-typescript": "^7.10.1",
    "svelte": "^5.45.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "ws": "^8.23.0"
  }
}
